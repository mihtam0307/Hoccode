/* ==================================================
   PYODIDE
================================================== */

async function loadPy() {

  if (pyodide) {

    return pyodide;

  }


  printConsole(
    "Đang tải môi trường Python WebAssembly..."
  );


  try {

    pyodide =
      await loadPyodide({

        indexURL:
          "https://cdn.jsdelivr.net/pyodide/v0.27.7/full/"

      });


    return pyodide;

  }


  catch (error) {

    printConsole(

      "Không thể tải môi trường Python.\n\n" +
      "Hãy kiểm tra kết nối Internet.",

      "error"

    );


    throw error;

  }

}


/* ==================================================
   DỊCH LỖI PYTHON
================================================== */

function translateError(error) {

  return String(error)

    .replace(
      "SyntaxError",
      "Lỗi cú pháp"
    )

    .replace(
      "NameError",
      "Lỗi tên biến"
    )

    .replace(
      "TypeError",
      "Lỗi kiểu dữ liệu"
    )

    .replace(
      "IndentationError",
      "Lỗi thụt lề"
    )

    .replace(
      "ZeroDivisionError",
      "Không thể chia cho 0"
    );

}


/* ==================================================
   CHẠY PYTHON
================================================== */

async function runPython(code) {

  try {

    const py =
      await loadPy();


    py.runPython(`

import sys

from io import StringIO

sys.stdout = StringIO()

sys.stderr = StringIO()

    `);


    py.runPython(code);


    const output =
      py.runPython(
        "sys.stdout.getvalue()"
      );


    const error =
      py.runPython(
        "sys.stderr.getvalue()"
      );


    if (error) {

      printConsole(

        "Lỗi Python:\n" +
        translateError(error),

        "error"

      );

    }


    else {

      printConsole(

        output ||
        "Chương trình đã chạy nhưng không có dữ liệu xuất ra.",

        "success"

      );

    }

  }


  catch (error) {

    printConsole(

      "Lỗi Python:\n" +
      translateError(
        error.message ||
        String(error)
      ),

      "error"

    );

  }

}


