/* ==================================================
   XP + TIẾN ĐỘ
================================================== */

function updateStats() {

  const xp =
    Number(
      localStorage.getItem(
        "xp"
      ) || 0
    );


  const completed =
    lessons.filter(
      lesson =>
        localStorage.getItem(
          "lesson_" +
          lesson.id
        )
    ).length;


  const percentage =
    Math.round(
      completed /
      lessons.length *
      100
    );


  document
    .getElementById("xp")
    .textContent =
      xp +
      " XP";


  document
    .getElementById("progress")
    .style.width =
      percentage +
      "%";


  document
    .getElementById("progressText")
    .textContent =
      percentage +
      "%";


  if (
    completed >= 1
  ) {

    document
      .getElementById("badge2")
      .classList
      .remove("locked");

  }


  if (
    completed >= 2
  ) {

    document
      .getElementById("badge3")
      .classList
      .remove("locked");

  }

}


/* ==================================================
   CONFETTI
================================================== */

function confetti() {

  const colors = [

    "#6366f1",

    "#22c55e",

    "#f59e0b",

    "#ef4444",

    "#06b6d4"

  ];


  for (
    let i = 0;
    i < 70;
    i++
  ) {

    const element =
      document.createElement(
        "i"
      );


    element.style.position =
      "fixed";


    element.style.width =
      "8px";


    element.style.height =
      "8px";


    element.style.left =
      Math.random() *
      100 +
      "vw";


    element.style.top =
      "-10px";


    element.style.zIndex =
      "9999";


    element.style.borderRadius =
      "2px";


    element.style.background =
      colors[
        Math.floor(
          Math.random() *
          colors.length
        )
      ];


    document.body
      .appendChild(
        element
      );


    const duration =
      1000 +
      Math.random() *
      1600;


    element.animate(

      [

        {
          transform:
            "translateY(0) rotate(0deg)",

          opacity: 1
        },

        {

          transform:
            `translateY(110vh) rotate(${Math.random() * 900}deg)`,

          opacity: 0

        }

      ],

      {

        duration,

        easing:
          "cubic-bezier(.2,.8,.3,1)"

      }

    );


    setTimeout(
      () =>
        element.remove(),
      duration
    );

  }

}


