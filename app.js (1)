    "html"
  ) {

    runHTML(code);

  }


  document
    .getElementById("status")
    .textContent =
      "Đã chạy";

}


/* ==================================================
   KIỂM TRA PYTHON
================================================== */

async function checkPython(
  code,
  lesson
) {

  try {

    const py =
      await loadPy();


    py.runPython(`

import sys

from io import StringIO

sys.stdout = StringIO()

    `);


    py.runPython(code);


    const output =
      py.runPython(
        "sys.stdout.getvalue()"
      )
      .trim();


    if (
      output ===
      lesson.answer
    ) {

      successLesson(
        lesson
      );

    }


    else {

      printConsole(

        "Chưa đúng.\n\n" +

        "Kết quả hiện tại:\n" +

        output,

        "error"

      );

    }

  }


  catch (error) {

    printConsole(

      "Code đang có lỗi:\n\n" +

      translateError(
        error.message ||
        String(error)
      ),

      "error"

    );

  }

}


/* ==================================================
   KIỂM TRA HTML
================================================== */

function checkHTML(
  code,
  lesson
) {

  const normalized =
    code
      .toLowerCase()
      .replace(/\s/g, "");


  const hasButton =
    normalized.includes(
      "<button>bắtđầuhọc</button>"
    );


  const hasGreen =
    normalized.includes(
      "background-color:green"
    );


  const hasHover =
    normalized.includes(
      "button:hover"
    );


  const hasDark =
    normalized.includes(
      "background-color:darkgreen"
    );


  if (
    hasButton &&
    hasGreen &&
    hasHover &&
    hasDark
  ) {

    successLesson(
      lesson
    );

  }


  else {

    printConsole(

      `Chưa đạt yêu cầu.

Hãy kiểm tra:

• Nội dung nút là "Bắt đầu học"

• Màu ban đầu là xanh lá

• Có bộ chọn button:hover

• Màu khi rê chuột là xanh đậm`,

      "error"

    );

  }

}


