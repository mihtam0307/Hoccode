/* ==================================================
   HOÀN THÀNH BÀI
================================================== */

function successLesson(
  lesson
) {

  const key =
    "lesson_" +
    lesson.id;


  if (
    !localStorage.getItem(key)
  ) {

    localStorage.setItem(
      key,
      "done"
    );


    const oldXP =
      Number(
        localStorage.getItem(
          "xp"
        ) || 0
      );


    localStorage.setItem(

      "xp",

      oldXP +
      lesson.xp

    );

  }


  printConsole(

    `🎉 Chính xác!

Bạn đã hoàn thành bài học.

+${lesson.xp} XP`,

    "success"

  );


  confetti();


  updateStats();

  renderRoadmap();

}


